{
  "name": "AI Video Starter Kit",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  // Port forwarding
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js App",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },

  // Environment variables from host
  "remoteEnv": {
    "DIGITALOCEAN_API_TOKEN": "${localEnv:DIGITALOCEAN_API_TOKEN}",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  // Mount Claude config for persistent authentication
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached"
  ],

  // Post-creation commands
  "postCreateCommand": "npm install && direnv allow",

  // VS Code customizations
  "customizations": {
    "vscode": {
      "extensions": [
        // Next.js / React
        "dbaeumer.vscode-eslint",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",

        // TypeScript
        "ms-vscode.vscode-typescript-next",

        // Development tools
        "ms-azuretools.vscode-docker",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "christian-kohler.path-intellisense",

        // Code quality
        "streetsidesoftware.code-spell-checker",
        "yzhang.markdown-all-in-one",

        // DigitalOcean
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        },
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
        ],
        "files.associations": {
          "*.css": "tailwindcss"
        },
        // direnv integration
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    }
  },

  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // This can be used to network with other containers or the host.
  // Removed deprecated "appPort" property; relying on "forwardPorts"

  // Comment out to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "node"
}
