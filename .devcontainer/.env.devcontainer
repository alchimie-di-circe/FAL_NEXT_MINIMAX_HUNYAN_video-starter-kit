# DevContainer Environment Variables
# This file contains non-sensitive default values for development
# Real secrets should be loaded via direnv (.envrc) or 1Password

# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Next.js
NEXT_TELEMETRY_DISABLED=1

# ============================================
# API Keys (Placeholder - Use direnv or 1Password)
# ============================================

# These should be set via .envrc or mounted from 1Password
# FAL_KEY=
# UPLOADTHING_TOKEN=
# KV_URL=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_REST_API_TOKEN=
# KV_REST_API_URL=

# ============================================
# Development Tools
# ============================================

# direnv configuration
DIRENV_LOG_FORMAT=

# Enable source maps for better debugging
NODE_OPTIONS="--enable-source-maps"

# ============================================
# DigitalOcean (Optional)
# ============================================

# Set via host environment or .envrc
# DIGITALOCEAN_API_TOKEN=
